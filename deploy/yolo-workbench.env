# Environment for the yolo-workbench service (/etc/yolo-workbench/yolo-workbench.env, read by the unit).
# Any setting of config.toml can be overridden here as WORKBENCH_<NAME>; nothing is required.

# WORKBENCH_LOG_LEVEL=debug
# WORKBENCH_ALLOWED_HOSTS=gpu-server,gpu-server.example.local,10.0.0.20

# Which GPU(s) the server and its training runs see (all by default).
# CUDA_VISIBLE_DEVICES=0

# Weights download from GitHub/Hugging Face on first use; behind a proxy:
# HTTPS_PROXY=http://proxy.example.local:3128
# NO_PROXY=localhost,127.0.0.1
